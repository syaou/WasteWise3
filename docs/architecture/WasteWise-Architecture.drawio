<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="WasteWise architecture" id="wastewise"><mxGraphModel page="1" pageScale="1" pageWidth="1600" pageHeight="1120" grid="1" gridSize="10"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="WasteWise — application architecture | Current implementation" style="text;html=1;align=left;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="15" width="1520" height="45" /></mxCell><mxCell id="boundary" value="HUMAN–SYSTEM BOUNDARY ─────────────────────────────────────────────────────────────────────────" style="text;align=left;fontSize=15;fontColor=#668376;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="192" width="1520" height="30" /></mxCell><mxCell id="human" value="&lt;b&gt;RESIDENT · HUMAN SIDE&lt;/b&gt;&lt;br&gt;Enter an item and tap “Check disposal guidance” • Save a household address • Choose reminder time&lt;br&gt;Read disposal advice in the app • Glance at the Home Screen widget • Expand a collection notification" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#e3f1e9;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1520" height="95" /></mxCell><mxCell id="views" value="&lt;b&gt;1  VIEWS · SwiftUI&lt;/b&gt;&lt;br&gt;ScanItemView (Check Item) • HomeView • CollectionCalendarView&lt;br&gt;CleanupBookingView • AddressEditorView • CollectionReminderSettingsView" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#ffffff;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="255" width="690" height="96" /></mxCell><mxCell id="vm" value="&lt;b&gt;2  VIEWMODELS&lt;/b&gt;&lt;br&gt;ScanItemViewModel • CollectionScheduleViewModel • CleanupBookingViewModel&lt;br&gt;Publish results and recovery messages; invoke use cases" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#ffffff;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="383" width="690" height="86" /></mxCell><mxCell id="uc" value="&lt;b&gt;3  USE CASES · domain rules + typed errors&lt;/b&gt;&lt;br&gt;ClassifyWasteItemUseCase → validate name; reject unsafe bin guidance&lt;br&gt;FindCollectionScheduleUseCase → validate address; derive 2026 dates&lt;br&gt;SubmitCleanupBookingUseCase → reject missing / prohibited items" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#ffffff;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="501" width="690" height="103" /></mxCell><mxCell id="repo" value="&lt;b&gt;4  REPOSITORY BOUNDARY&lt;/b&gt;&lt;br&gt;WasteWiseRepository protocol → LocalWasteWiseRepository&lt;br&gt;Maps stored records into WasteItem domain values" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#ffffff;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="636" width="690" height="86" /></mxCell><mxCell id="db" value="&lt;b&gt;5  CORE DATA · app-private persistent store&lt;/b&gt;&lt;br&gt;DisposalCatalogueStore → NSPersistentContainer → local SQLite store&lt;br&gt;DisposalCategory 1 ←→ many WasteItemRecord&lt;br&gt;First access: seed + save if empty. Lookup: name ==[c] entered name." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#e3f1e9;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="762" width="690" height="117" /></mxCell><mxCell id="flow" value="&lt;b&gt;PRIMARY FLOW · check an item&lt;/b&gt;&lt;br&gt;Request ↓  Resident → View → ViewModel → Use Case → Repository&lt;br&gt;First access → initialise catalogue → save seed records to Core Data&lt;br&gt;Read → fetch matching item + category → map to domain guidance&lt;br&gt;Response ↑  Repository → Use Case → ViewModel → View → resident&lt;br&gt;Later lookups read existing records; they do not save user searches." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#f0f5f2;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="920" width="690" height="139" /></mxCell><mxCell id="coord" value="&lt;b&gt;MAIN APP · collection and reminder coordination&lt;/b&gt;&lt;br&gt;ContentView observes CollectionScheduleViewModel.result&lt;br&gt;Saves / clears widget snapshot; calls WidgetCenter.reloadTimelines&lt;br&gt;Passes address + collection metadata to CollectionReminderController" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#ffffff;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="255" width="685" height="96" /></mxCell><mxCell id="group" value="&lt;b&gt;APP GROUP · shared UserDefaults container&lt;/b&gt;&lt;br&gt;group.com.WasteWise.sana.Wastewise&lt;br&gt;CollectionWidgetStore stores Codable collection dates; no address" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#e7effb;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="397" width="685" height="85" /></mxCell><mxCell id="widget" value="&lt;b&gt;EXTENSION 1 · WidgetKit / ReminderExtension&lt;/b&gt;&lt;br&gt;Reads shared dates → builds timeline → renders collection countdown&lt;br&gt;Small + medium families; resident views on the Home Screen" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#e7effb;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="526" width="685" height="86" /></mxCell><mxCell id="notify" value="&lt;b&gt;MAIN APP → iOS NOTIFICATION SERVICE&lt;/b&gt;&lt;br&gt;CollectionReminderController → UNUserNotificationCenter&lt;br&gt;Opt-in weekly trigger + payload: weekday, recycling area, version" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#ffffff;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="659" width="685" height="86" /></mxCell><mxCell id="content" value="&lt;b&gt;EXTENSION 2 · CollectionNotificationContent&lt;/b&gt;&lt;br&gt;iOS routes WASTEWISE_USUAL_COLLECTION notifications on expansion&lt;br&gt;NotificationViewController reads payload → custom weekday / area view" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#e7effb;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="792" width="685" height="86" /></mxCell><mxCell id="side" value="&lt;b&gt;OTHER DATA PATHS &amp;amp; IMPLEMENTATION LIMITS&lt;/b&gt;&lt;br&gt;Repository → ArcGISBinService → council network service for zones&lt;br&gt;ResidentAddressStore + reminder controller → app-local UserDefaults&lt;br&gt;Notification extension: payload only; no App Group / database access&lt;br&gt;Cleanup operation: demo receipt only; no saved or submitted booking&lt;br&gt;Domain models: WasteItem • CollectionSchedule • CleanupBookingRequest" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fontSize=15;fillColor=#fff3dc;strokeColor=#bfd0c7;fontColor=#183a30;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="920" width="685" height="139" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="human" target="views"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="views" target="vm"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="vm" target="uc"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="uc" target="repo"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="repo" target="db"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#668376;fontSize=13;" edge="1" parent="1" source="db" target="views"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="45" y="820" /><mxPoint x="45" y="302" /></Array></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="vm" target="coord"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="800" y="426" /><mxPoint x="800" y="303" /></Array></mxGeometry></mxCell><mxCell id="e7" value="write / clear" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="coord" target="group"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="read snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="group" target="widget"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="coord" target="notify"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1555" y="302" /><mxPoint x="1555" y="700" /></Array></mxGeometry></mxCell><mxCell id="e10" value="category + payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#27745c;fontSize=13;" edge="1" parent="1" source="notify" target="content"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>